# Identity Hunt — Docker & Environment Configuration

# (Optional) Groq API Key. If empty, the backend automatically uses the built-in mock provider for offline play.
GROQ_API_KEY=

# Model identifier for Groq provider
GROQ_MODEL=llama-3.3-70b-versatile

# LLM provider mode: auto | groq | mock
LLM_PROVIDER=auto

# Host ports to expose
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend URL accessible by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# Allowed CORS origins for the backend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
