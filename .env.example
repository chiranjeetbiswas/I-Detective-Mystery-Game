# Identity Hunt — Docker & Environment Configuration

# (Optional) AgentRouter API key. If empty, the backend automatically uses the built-in mock provider for offline play.
AGENTROUTER_API_KEY=

# Model identifier for the AgentRouter provider
AGENTROUTER_MODEL=claude-opus-5

# AgentRouter base URL (OpenAI-compatible gateway)
AGENTROUTER_BASE_URL=https://agentrouter.org/v1

# LLM provider mode: auto | agentrouter | mock
LLM_PROVIDER=auto

# Host ports to expose
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend URL accessible by the browser
NEXT_PUBLIC_API_URL=http://localhost:8000

# Allowed CORS origins for the backend (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
