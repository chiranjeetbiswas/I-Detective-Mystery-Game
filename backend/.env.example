GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_PROVIDER=auto
DATA_DIR=./data
# Comma-separated list of allowed browser origins (NO trailing slash needed).
# Add your deployed frontend origin here, e.g. on Render:
#   CORS_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: allow origins by regex instead of / in addition to the list above.
# Example to allow any Render subdomain:
#   CORS_ORIGIN_REGEX=https://.*\.onrender\.com
CORS_ORIGIN_REGEX=
