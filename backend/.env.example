# AgentRouter (OpenAI-compatible gateway). Leave the key blank to skip it.
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=claude-opus-5
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# auto | agentrouter | mock
# "auto" prefers AgentRouter, then the offline mock provider.
# The network provider runs as a failover chain, so an exhausted quota or a
# rate limit falls through to the mock provider instead of failing the request.
LLM_PROVIDER=auto
DATA_DIR=./data
# Comma-separated list of allowed browser origins (NO trailing slash needed).
# Add your deployed frontend origin here, e.g. on Render:
#   CORS_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: allow origins by regex instead of / in addition to the list above.
# Default allows any Render subdomain so the deployed frontend works out of the
# box. Clear it (CORS_ORIGIN_REGEX=) to restrict access to CORS_ORIGINS only.
CORS_ORIGIN_REGEX=https://.*\.onrender\.com
