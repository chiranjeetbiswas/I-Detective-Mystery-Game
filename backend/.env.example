# AgentRouter (OpenAI-compatible gateway). Leave the key blank to skip it.
AGENTROUTER_API_KEY=
AGENTROUTER_MODEL=claude-opus-5
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
# Groq (free tier: https://console.groq.com/keys). Leave the key blank to skip it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# auto | agentrouter | groq | mock
# "auto" chains every provider that has a key: AgentRouter, then Groq, then the
# offline mock. So with only GROQ_API_KEY set, Groq is used.
# The network providers run as a failover chain, so an exhausted quota or a
# rate limit falls through to the next provider instead of failing the request.
LLM_PROVIDER=auto
DATA_DIR=./data
# Accounts database. Leave blank to use a SQLite file inside DATA_DIR.
# For Postgres: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=
# Secret that signs login tokens. Set a long random value in production, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If blank, a random one is used and everyone is signed out on each restart.
JWT_SECRET=
JWT_EXPIRE_MINUTES=10080
# Comma-separated list of allowed browser origins (NO trailing slash needed).
# Add your deployed frontend origin here, e.g. on Render:
#   CORS_ORIGINS=http://localhost:3000,https://your-frontend.onrender.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: allow origins by regex instead of / in addition to the list above.
# Default allows any Render subdomain so the deployed frontend works out of the
# box. Clear it (CORS_ORIGIN_REGEX=) to restrict access to CORS_ORIGINS only.
CORS_ORIGIN_REGEX=https://.*\.onrender\.com
